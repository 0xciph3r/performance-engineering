{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "GPU Utilization (%)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "legend": { "showLegend": true, "placement": "bottom", "displayMode": "table" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "dcgm_gpu_utilization", "legendFormat": "{{gpu}}", "range": true }
      ]
    },
    {
      "title": "GPU Memory Used (GiB)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "legend": { "showLegend": true, "placement": "bottom", "displayMode": "table" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "dcgm_gpu_memory_used_bytes / 1024^3", "legendFormat": "{{gpu}}", "range": true }
      ]
    },
    {
      "title": "GPU Temperature (C)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "legend": { "showLegend": true, "placement": "bottom", "displayMode": "table" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "dcgm_gpu_temperature_celsius", "legendFormat": "{{gpu}}", "range": true }
      ]
    },
    {
      "title": "GPU Power (W)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "legend": { "showLegend": true, "placement": "bottom", "displayMode": "table" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "dcgm_gpu_power_usage_watts", "legendFormat": "{{gpu}}", "range": true }
      ]
    },
    {
      "title": "FP16 Dense TFLOPS",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "legend": { "showLegend": true, "placement": "bottom", "displayMode": "table" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "dcgm_gpu_fp16_tflops", "legendFormat": "{{gpu}}", "range": true }
      ]
    },
    {
      "title": "NVLink TX Bandwidth (GB/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "binBps",
          "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "legend": { "showLegend": true, "placement": "bottom", "displayMode": "table" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (gpu) (dcgm_gpu_nvlink_tx_bytes) / 1024^3", "legendFormat": "{{gpu}}", "range": true }
      ]
    },
    {
      "title": "Fleet Util (avg %)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "color": { "mode": "thresholds" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["mean"], "values": false } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "avg(dcgm_gpu_utilization)", "range": true }
      ]
    },
    {
      "title": "Peak GPU Temp (C)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "celsius", "color": { "mode": "thresholds" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["max"], "values": false } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max(dcgm_gpu_temperature_celsius)", "range": true }
      ]
    },
    {
      "title": "Fleet Power (kW)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "kwatt", "color": { "mode": "thresholds" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["sum"], "values": false } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(dcgm_gpu_power_usage_watts)/1000", "range": true }
      ]
    },
    {
      "title": "GPUs Reporting",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "none", "color": { "mode": "thresholds" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["last"], "values": false } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "count(dcgm_gpu_utilization)", "range": true }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["gpu", "dcgm", "simulated"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
